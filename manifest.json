{
  "manifest_version": 3,
  "name": "集锦",
  "version": "0.3.1",
  "description": "仿原Edge集锦的侧边栏集锦功能，支持修改、排序、批注、右键添加等功能。特色：支持原有Edge集锦数据文件兼容导入，无缝衔接使用！",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "tabs"
  ],
  "action": {
    "default_title": "打开集锦",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-collections": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "打开集锦侧边栏"
    }
  }
}
